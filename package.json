{
  "name": "@araute/sdk",
  "version": "0.1.0",
  "description": "Bun and Node.js SDK for the Araute public API.",
  "packageManager": "bun@1.3.10",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc -p tsconfig.json",
    "pack": "bun pm pack",
    "publish:dry-run": "bun publish --dry-run"
  },
  "keywords": [
    "araute",
    "payments",
    "sdk",
    "typescript",
    "nodejs",
    "bun"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsdown": "^0.16.6",
    "typescript": "^5.9.2"
  }
}
