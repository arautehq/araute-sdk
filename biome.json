{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["src/**/*.ts", "test/**/*.ts"]
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "off"
      },
      "style": {
        "useImportType": "off"
      }
    }
  },
  "assist": {
    "enabled": false
  },
  "formatter": {
    "enabled": false
  }
}
